{
  "mui": {
    "imports": {
      "@mui/material": "@runox/ui"
    },
    "components": {
      "Typography": "Text",
      "Stack": "Flex",
      "TextField": "Input",
      "CircularProgress": "Spinner"
    },
    "props": {
      "Typography": {
        "variant": {
          "h1": "h1",
          "h2": "h2",
          "h3": "h3",
          "body1": "p",
          "body2": "p"
        }
      },
      "Button": {
        "variant": {
          "contained": "solid",
          "outlined": "outline",
          "text": "ghost"
        },
        "color": {
          "primary": "primary",
          "secondary": "secondary",
          "error": "destructive"
        }
      }
    }
  },
  "chakra": {
    "imports": {
      "@chakra-ui/react": "@runox/ui"
    },
    "components": {
      "VStack": "Flex",
      "HStack": "Flex",
      "Stack": "Flex",
      "Heading": "Text"
    },
    "props": {
      "Button": {
        "colorScheme": "color",
        "variant": {
          "solid": "solid",
          "outline": "outline",
          "ghost": "ghost"
        }
      },
      "VStack": {
        "spacing": "gap",
        "alignItems": "align",
        "align": "align",
        "justifyContent": "justify",
        "justify": "justify"
      },
      "HStack": {
        "spacing": "gap",
        "alignItems": "align",
        "align": "align",
        "justifyContent": "justify",
        "justify": "justify"
      },
      "Stack": {
        "spacing": "gap",
        "alignItems": "align",
        "align": "align",
        "justifyContent": "justify",
        "justify": "justify"
      }
    }
  },
  "shadcn": {
    "imports": {
      "@/components/ui/button": "@runox/ui",
      "@/components/ui/input": "@runox/ui",
      "@/components/ui/badge": "@runox/ui",
      "@/components/ui/card": "@runox/ui"
    },
    "components": {
      "CardHeader": "Card.Header",
      "CardContent": "Card.Body",
      "CardFooter": "Card.Footer",
      "CardTitle": "Card.Title",
      "CardDescription": "Card.Description"
    },
    "props": {
      "Button": {
        "variant": {
          "default": "solid",
          "destructive": "solid",
          "outline": "outline",
          "secondary": "solid",
          "ghost": "ghost",
          "link": "ghost"
        }
      }
    }
  }
}
