  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=8192 tsup && tsc --emitDeclarationOnly --outDir dist",
    "postbuild": "node scripts/postbuild.js && node scripts/build-types.js",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "test:coverage": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --coverage",
    "test:exports": "node scripts/verify-package-exports.js",
    "test:package": "node scripts/test-packed-package.js",
    "test:conventions": "node scripts/check-style-conventions.js",
    "prepare": "husky",
    "build:npm": "npm run build && npm pack",
    "yalc:push": "npm run build && yalc push",
    "release": "changeset publish"
  },
